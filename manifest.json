{
  "manifestVersion": 6,
  "id": "com.madebykraman.beatcheatpro",
  "name": "BeatCheat Pro",
  "version": "0.2.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "addon": {
    "name": "beatcheatpro_dsp.uxpaddon"
  },
  "entrypoints": [
    {
      "id": "beatcheat-panel",
      "type": "panel",
      "label": { "default": "BeatCheat Pro" },
      "minimumSize": { "width": 320, "height": 420 },
      "preferredDockedSize": { "width": 360, "height": 560 },
      "preferredFloatingSize": { "width": 420, "height": 640 }
    },
    {
      "id": "analyze-command",
      "type": "command",
      "label": { "default": "Analyze Audio with BeatCheat Pro" }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request",
    "enableAddon": true
  }
}